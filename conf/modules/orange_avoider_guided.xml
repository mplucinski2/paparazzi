<!DOCTYPE module SYSTEM "module.dtd">

<module name="orange_avoider_guided" dir="orange_avoider">
  <doc>
    <description>
      Orange (now Green) Avoider algorithm using guided mode
    </description>
    <define name="ORANGE_AVOIDER_VISUAL_DETECTION_ID" value="ABI_BROADCAST" description="which VISUAL_DETECTION message to recieve for obstacle detection."/>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings name="GreenAvoider">
         <dl_setting var="oag_color_count_frac" min="0.05" step="0.01" max="1.0" shortname="green_threshold"/>
         <dl_setting var="oag_max_speed" min="0.1" step="0.1" max="2.0" shortname="max_speed"/>
         <dl_setting var="oag_heading_rate" min="5" step="5" max="90" shortname="heading_rate" module="orange_avoider/orange_avoider_guided" handler="SetHeadingRate"/>
         <dl_setting var="oag_roi_width" min="0.1" step="0.1" max="1.0" shortname="roi_width"/>
         <dl_setting var="oag_roi_height" min="0.1" step="0.1" max="1.0" shortname="roi_height"/>
      </dl_settings>
    </dl_settings>
  </settings>
  
  <dep>
    <depends>cv_detect_color_object</depends>
  </dep>
  <header>
    <file name="orange_avoider_guided.h"/>
  </header>
  <init fun="orange_avoider_guided_init()"/>
  <periodic fun="orange_avoider_guided_periodic()" freq="30" start="FALSE" stop="FALSE" autorun="TRUE"/>
  <makefile target="ap|nps">
    <file name="orange_avoider_guided.c"/>
  </makefile>
</module>
